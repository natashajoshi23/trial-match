# Copy this file to .env and fill in your values.
# .env is git-ignored; .env.example is committed as a template.

# Optional — when set, uses OpenAI text-embedding-3-small (faster, higher quality).
# When absent, falls back to sentence-transformers/all-MiniLM-L6-v2 (local, free).
OPENAI_API_KEY=

# Override default data paths (rarely needed; docker-compose volumes handle this)
# CHROMA_DIR=/app/data/chroma
# CACHE_DIR=/app/data/cache
